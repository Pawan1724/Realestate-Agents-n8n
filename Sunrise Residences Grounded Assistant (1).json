    {
      "parameters": {
        "jsCode": "const input = $input.first().json;\n\nconst points = Array.isArray(input.result?.points)\n  ? input.result.points\n  : [];\n\nconst MIN_SCORE = 0.15;\n\nconst results = points\n  .filter(p => p?.payload?.text)\n  .map((p, index) => ({\n    rank: index + 1,\n    score: Number(p.score ?? 0),\n    text: p.payload.text,\n    chunk_id: p.payload.chunk_id ?? null,\n    document: p.payload.document ?? null,\n    page: p.payload.page ?? null\n  }));\n\nconst relevant = results.filter(\n  r => r.score >= MIN_SCORE\n);\n\nconst context = relevant\n  .map(\n    r =>\n      `[Source ${r.rank} | similarity ${r.score.toFixed(3)}]\\n${r.text}`\n  )\n  .join(\"\\n\\n\");\n\nreturn [\n  {\n    json: {\n      query: $('Prepare Query').first().json.query,\n      results: relevant,\n      has_evidence: relevant.length > 0,\n      result_count: relevant.length,\n      context\n    }\n  }\n];"
      },
