      "parameters": {
        "jsCode": "const raw = $json.text ?? $json.output ?? \"\";\n\nlet parsed;\n\ntry {\n  parsed = typeof raw === \"string\"\n    ? JSON.parse(raw)\n    : raw;\n} catch (error) {\n  parsed = {\n    intent: \"OUT_OF_SCOPE\"\n  };\n}\n\nreturn [\n  {\n    json: {\n      query: $('Prepare Query').first().json.query,\n      intent: parsed.intent === \"REAL_ESTATE\"\n        ? \"REAL_ESTATE\"\n        : \"OUT_OF_SCOPE\"\n    }\n  }\n];"
      },
