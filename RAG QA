    {
      "parameters": {
        "jsCode": "const results = $json.result || [];\n\nconst MIN_SCORE = 0.70;\nconst relevant = results.filter(r => Number(r.score) >= MIN_SCORE);\n\nif (relevant.length === 0) {\n  return [{\n    json: {\n      context_found: false,\n      answer: 'I could not find reliable information about that in the knowledge base.',\n      retrieved_count: 0\n    }\n  }];\n}\n\nconst context = relevant.map((r, i) => {\n  const p = r.payload || {};\n  return `SOURCE ${i + 1}\\nDocument: ${p.document_name || 'Unknown'}\\nContent:\\n${p.text || p.content || ''}`;\n}).join('\\n\\n---\\n\\n');\n\nreturn [{\n  json: {\n    context_found: true,\n    retrieved_count: relevant.length,\n    context,\n    scores: relevant.map(r => r.score)\n  }\n}];"
      },
