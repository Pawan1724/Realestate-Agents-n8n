    {
      "parameters": {
        "jsCode": "const answer = $json.choices?.[0]?.message?.content?.trim();\n\nif (!answer) {\n  return [{\n    json: {\n      ok: false,\n      grounded: false,\n      error: 'EMPTY_LLM_RESPONSE',\n      answer: 'I was unable to generate a reliable answer.'\n    }\n  }];\n}\n\nconst forbiddenPatterns = [\n  /system prompt/i,\n  /developer message/i,\n  /api key/i,\n  /secret key/i,\n  /internal instructions/i\n];\n\nconst suspicious = forbiddenPatterns.some(p => p.test(answer));\n\nif (suspicious) {\n  return [{\n    json: {\n      ok: false,\n      grounded: false,\n      error: 'OUTPUT_GUARDRAIL_BLOCKED',\n      answer: 'I cannot provide that information.'\n    }\n  }];\n}\n\nreturn [{\n  json: {\n    ok: true,\n    grounded: true,\n    answer,\n    model: $json.model || 'openrouter-model'\n  }\n}];"
      },
      "id": "534aad97-2b4b-4cd0-9948-2ca1c88bd6d0",
      "name": "Output Guardrail",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
