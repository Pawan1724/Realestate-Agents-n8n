    {
      "parameters": {
        "jsCode": "const body = $json.body || $json;\nconst question = typeof body.question === 'string' ? body.question.trim() : '';\n\nif (!question) {\n  return [{\n    json: {\n      ok: false,\n      guardrail_blocked: true,\n      error: 'EMPTY_QUESTION',\n      message: 'Please provide a question.'\n    }\n  }];\n}\n\nif (question.length > 4000) {\n  return [{\n    json: {\n      ok: false,\n      guardrail_blocked: true,\n      error: 'QUESTION_TOO_LONG',\n      message: 'The question is too long.'\n    }\n  }];\n}\n\nconst suspiciousPatterns = [\n  /ignore\\s+(all\\s+)?previous\\s+instructions/i,\n  /reveal\\s+(your|the)\\s+system\\s+prompt/i,\n  /show\\s+(me\\s+)?your\\s+system\\s+message/i,\n  /developer\\s+message/i\n];\n\nconst injectionDetected = suspiciousPatterns.some(p => p.test(question));\n\nif (injectionDetected) {\n  return [{\n    json: {\n      ok: false,\n      guardrail_blocked: true,\n      error: 'PROMPT_INJECTION_DETECTED',\n      message: 'I can help answer questions about the available knowledge base, but I cannot provide internal instructions.'\n    }\n  }];\n}\n\nreturn [{\n  json: {\n    ok: true,\n    question,\n    guardrail_blocked: false\n  }\n}];"
      },
